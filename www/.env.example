# Cloudflare Workers Environment Variables
# Copy this file to .env.local and fill in your actual values

# Backend URL for Durable Objects
# For local development, use: http://localhost:8787
# For production, use your deployed Cloudflare Worker URL
VITE_BACKEND_URL=http://localhost:8787

# Space ID for the Durable Object
# This can be any string identifier for your space
VITE_SPACE_ID=default-space